{
	"nodes":[
		{"id":"dd6f4f1691f7235b","type":"text","text":"Java主流锁","x":-480,"y":-160,"width":120,"height":60},
		{"id":"bfaa1e2381ca3ca9","type":"text","text":"多个线程竞争同步资源细节有没有区别","x":-202,"y":-220,"width":250,"height":60},
		{"id":"b0816a62956a8931","type":"text","text":"## 无锁","x":641,"y":-363,"width":250,"height":60},
		{"id":"038179c0a0415263","type":"text","text":"## 重量锁","x":641,"y":-73,"width":250,"height":60},
		{"id":"5229b10d30211e0f","type":"text","text":"阻塞","x":203,"y":-657,"width":250,"height":60},
		{"id":"d8b3137f2fa7ac36","type":"text","text":"## 悲观锁","x":370,"y":-898,"width":149,"height":60},
		{"id":"2f637fbf4ca60a79","type":"text","text":"不锁住","x":203,"y":-810,"width":96,"height":60},
		{"id":"8292492ef5e8a912","type":"text","text":"## 乐观锁","x":377,"y":-810,"width":142,"height":60},
		{"id":"acf36f53636247f5","type":"text","text":"不阻塞","x":201,"y":-556,"width":250,"height":60},
		{"id":"0bbb14a40df056cc","type":"text","text":"不锁柱资源，多个线程只有一个能修改资源成功，其他都会重试","x":203,"y":-380,"width":282,"height":91},
		{"id":"a114d87f19f330a6","type":"text","text":"多个线程同时竞争资源","x":203,"y":-74,"width":250,"height":60},
		{"id":"16a37172623812af","type":"text","text":"锁住","x":203,"y":-897,"width":78,"height":60},
		{"id":"ff3d3e098a21295c","type":"text","text":"## 自旋锁","x":641,"y":-616,"width":250,"height":60},
		{"id":"8668e42796f31dad","type":"text","text":"## 适应性自旋锁","x":641,"y":-516,"width":250,"height":60},
		{"id":"5db20f0892c4222e","type":"text","text":"排队","x":203,"y":50,"width":250,"height":60},
		{"id":"f6409f006db1a2e3","type":"text","text":"先尝试插队，失败后再排队","x":203,"y":182,"width":250,"height":60},
		{"id":"54bbf3e1f46b02d8","type":"text","text":"多个线程竞争锁时要不要排队","x":-202,"y":122,"width":250,"height":60},
		{"id":"cc8a1bea32e1945d","type":"text","text":"锁住同步资源失败，线程要不要阻塞","x":-202,"y":-616,"width":250,"height":60},
		{"id":"bef33f63c5a89cad","type":"text","text":"线程要不要锁住同步资源","x":-202,"y":-867,"width":226,"height":60},
		{"id":"7f5552dc48061854","type":"text","text":"## 公平锁","x":641,"y":50,"width":250,"height":60},
		{"id":"3dcc16654e5e2496","type":"text","text":"## 非公平锁","x":641,"y":182,"width":250,"height":60},
		{"id":"6b36be6141d65afb","type":"text","text":"一个线程的多个流程能否获取同一个锁","x":-213,"y":364,"width":250,"height":60},
		{"id":"44088271f731dd11","type":"text","text":"多个线程能否公用一把锁","x":-243,"y":588,"width":250,"height":60},
		{"id":"9407fbd1285e885d","type":"text","text":"能","x":203,"y":334,"width":250,"height":60},
		{"id":"7e75ee8b4876b0d3","type":"text","text":"不能","x":203,"y":424,"width":250,"height":60},
		{"id":"ed534c73deff42d8","type":"text","text":"能","x":203,"y":555,"width":250,"height":60},
		{"id":"ad1defc9cad720e4","type":"text","text":"不能","x":203,"y":654,"width":250,"height":60},
		{"id":"bd8c4e738ff105a7","type":"text","text":"## 可重入锁","x":641,"y":334,"width":250,"height":60},
		{"id":"9b9b12b10a26daf0","type":"text","text":"## 不可重入锁","x":641,"y":454,"width":250,"height":60},
		{"id":"7154c996143f6bc1","type":"text","text":"## 共享锁","x":641,"y":555,"width":250,"height":60},
		{"id":"01b03cc7c62d84bc","type":"text","text":"## 排他锁","x":641,"y":654,"width":250,"height":60},
		{"id":"a23f7ac6d1aabf07","type":"text","text":"大部分时间都是只有一个线程对同步资源进行竞争","x":203,"y":-250,"width":250,"height":60},
		{"id":"bcb7905c02af874e","type":"text","text":"多个线程对同步资源竞争基本不会发生","x":203,"y":-160,"width":250,"height":60},
		{"id":"3f151579e9a66972","type":"text","text":"## 偏向锁","x":641,"y":-250,"width":250,"height":60},
		{"id":"c992a610c1619099","type":"text","text":"[轻量锁](4.2.轻量锁.md)","x":641,"y":-160,"width":250,"height":60},
		{"id":"155be705d70df277","x":1160,"y":-220,"width":250,"height":60,"type":"text","text":"锁等级由低到高，锁可以升级，但不能降级"}
	],
